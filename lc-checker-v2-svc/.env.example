# lc-checker-v2-svc environment variables
# Copy to .env for local dev; copy to .env.ubuntu for Ubuntu Docker deployment.

# --- Text LLM (Spring AI ChatClient) ---
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.5-plus-2026-04-20
LLM_API_KEY=your-api-key-here

# --- Vision extractor primary slot (local Ollama) ---
EXTRACTOR_PRIMARY_BASE_URL=http://192.168.31.201:11434/v1
EXTRACTOR_PRIMARY_MODEL=qwen3-vl:4b-instruct
EXTRACTOR_PRIMARY_API_KEY=

# --- Vision extractor compare slot (cloud, default enabled) ---
EXTRACTOR_COMPARE_ENABLED=true
EXTRACTOR_COMPARE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXTRACTOR_COMPARE_MODEL=qwen3.6-plus-2026-04-02
EXTRACTOR_COMPARE_API_KEY=your-api-key-here

# --- Vision extractor benchmark slot (default disabled) ---
EXTRACTOR_BENCHMARK_ENABLED=false
EXTRACTOR_BENCHMARK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EXTRACTOR_BENCHMARK_MODEL=qwen3.6-flash
EXTRACTOR_BENCHMARK_API_KEY=your-api-key-here

# --- Database ---
DB_HOST=192.168.31.214
DB_PORT=5432
DB_USER=lcuser
DB_PASSWORD=lcpass123

# --- MinIO ---
MINIO_ENABLED=true
MINIO_ENDPOINT=http://192.168.31.214:9000
MINIO_BUCKET=lc-pdfs
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# --- Langfuse ---
LANGFUSE_HOST=http://192.168.31.214:3300
LANGFUSE_AUTH_BASIC=
TRACING_ENABLED=true

# --- Dev mode ---
DEV_MODE=true

# --- Server ---
SERVER_PORT=9082
