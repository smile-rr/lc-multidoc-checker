<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- Log directory — override via logging.file.path env var or application.yml -->
  <property name="LOG_DIR" value="/tmp/lc-checker-v2" />
  <property name="LOG_PATTERN_CONSOLE"
            value="%d{HH:mm:ss.SSS} %-5level [%thread] %X{sessionId:-} %X{stage:-} %X{ruleId:-} %logger{36} - %msg%n" />
  <property name="LOG_PATTERN_FILE"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %X{sessionId:-} %X{stage:-} %X{ruleId:-} %logger{36} - %msg%n" />

  <!-- Console -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${LOG_PATTERN_CONSOLE}</pattern>
    </encoder>
  </appender>

  <!-- Rolling file — daily rollover, keep 7 days, cap 100 MB total -->
  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/svc.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/svc.%d{yyyy-MM-dd}.log</fileNamePattern>
      <maxHistory>7</maxHistory>
      <totalSizeCap>100MB</totalSizeCap>
    </rollingPolicy>
    <encoder>
      <pattern>${LOG_PATTERN_FILE}</pattern>
    </encoder>
  </appender>

  <!-- Logger levels (mirrors application.yml logging.level.*) -->
  <logger name="com.lc.v2.checker"                          level="DEBUG" />
  <logger name="org.springframework.ai"                     level="INFO"  />
  <logger name="io.opentelemetry.exporter.internal.http"    level="WARN"  />
  <logger name="org.springframework.web"                    level="INFO"  />
  <logger name="org.springframework.jdbc"                   level="INFO"  />

  <root level="INFO">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
  </root>

</configuration>
