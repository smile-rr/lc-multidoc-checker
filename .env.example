# LC Checker v2 — local development environment template
# Copy to `.env` and fill in your API keys. `.env` is git-ignored.

# =============================================================================
# LLM — Text model for agent rule checks (AGENT rules in Examine stage)
# Bailian DashScope. Active models: qwen3.6-flash, qwen3.5-flash.
# enable_thinking=false is applied globally in application.yml via Spring AI.
# =============================================================================
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.6-flash

# =============================================================================
# Vision LLM — Slots 1–4 (uniform config; source label in DB/UI: <model>_<N>)
# Selection: consensus vote across enabled slots; slot-1 wins on tie.
# Active models: qwen3.6-flash (slot 1), qwen3.5-flash (slot 2).
# =============================================================================
VISION_1_ENABLED=true
VISION_1_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_1_API_KEY=
VISION_1_MODEL=qwen3.6-flash
VISION_1_RENDER_DPI=200
VISION_1_MAX_PAGES=10
VISION_1_MAX_LONG_EDGE_PX=2048
VISION_1_TIMEOUT_SECONDS=120

VISION_2_ENABLED=true
VISION_2_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_2_API_KEY=
VISION_2_MODEL=qwen3.5-flash
VISION_2_RENDER_DPI=200
VISION_2_MAX_PAGES=10
VISION_2_MAX_LONG_EDGE_PX=2048
VISION_2_TIMEOUT_SECONDS=120

VISION_3_ENABLED=false
VISION_3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_3_API_KEY=
VISION_3_MODEL=qwen3.6-plus-2026-04-02
VISION_3_RENDER_DPI=200
VISION_3_MAX_PAGES=10
VISION_3_MAX_LONG_EDGE_PX=2048
VISION_3_TIMEOUT_SECONDS=120

VISION_4_ENABLED=false
VISION_4_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_4_API_KEY=
VISION_4_MODEL=qwen3.6-27b
VISION_4_RENDER_DPI=200
VISION_4_MAX_PAGES=10
VISION_4_MAX_LONG_EDGE_PX=2048
VISION_4_TIMEOUT_SECONDS=120

# =============================================================================
# Extractor
# =============================================================================
EXTRACTOR_CONFIDENCE_THRESHOLD=0.80

# =============================================================================
# Port bindings
# =============================================================================
SERVER_PORT=9082
POSTGRES_PORT=5432

# =============================================================================
# PostgreSQL 16 — local instance
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=lcuser
DB_PASSWORD=

# =============================================================================
# Spring profile
# =============================================================================
SPRING_PROFILES_ACTIVE=default

# =============================================================================
# MinIO — shared with v1, separate bucket prefix (v2/)
# =============================================================================
MINIO_ENABLED=true
MINIO_ENDPOINT=http://192.168.31.214:9000
MINIO_BUCKET=lc-pdfs-v2
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_PATH_STYLE=true
MINIO_REQUEST_TIMEOUT_SECONDS=30

# =============================================================================
# Langfuse — LLM tracing
# =============================================================================
LANGFUSE_HOST=http://192.168.31.214:3300
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_AUTH_BASIC=

# =============================================================================
# Dev mode — enables "Confirm All" + "Pass All" shortcuts in Examine stage UI
# Never enable in production.
# =============================================================================
DEV_MODE=true
