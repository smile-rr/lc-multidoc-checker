# LC Checker v2 — secrets template (copy to .env and fill in).
# Operational config is hardcoded in
# lc-checker-v2-svc/src/main/resources/application.yml — edit there for
# URLs, model names, ports, slot tunings, timeouts, feature flags.

# Text LLM (rule checks via Spring AI ChatClient)
LLM_API_KEY=

# Vision LLM slot keys (1–4). Slot 3 (Ollama) needs no key — leave blank.
VISION_1_API_KEY=
VISION_2_API_KEY=
VISION_3_API_KEY=
VISION_4_API_KEY=

# PostgreSQL — leave blank to use Ubuntu defaults (192.168.31.214:5436 / lcuser);
# set HOST/PORT/NAME/USERNAME locally to point at a Mac-side Postgres.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# MinIO
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Langfuse — public+secret keys, plus pre-derived basic auth header
# (LANGFUSE_AUTH_BASIC = base64(public_key + ':' + secret_key);
#  regenerate via `make langfuse-auth` after rotating keys)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_AUTH_BASIC=
