# LC Checker v2 — secrets template (copy to .env and fill in).
# Operational config is hardcoded in
# lc-checker-v2-svc/src/main/resources/application.yml — edit there for
# URLs, model names, ports, slot tunings, timeouts, feature flags.

# Text LLM (rule checks via Spring AI ChatClient)
LLM_API_KEY=

# Vision LLM slot keys (1–4). Slot 3 (Ollama) needs no key — leave blank.
VISION_1_API_KEY=
VISION_2_API_KEY=
VISION_3_API_KEY=
VISION_4_API_KEY=

# PostgreSQL — local dev defaults match `make db` (lcuser/lcdev @ localhost:5432).
# Leave blank to use Ubuntu production defaults (192.168.31.214:5436 / lcuser).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lc_checker
DB_USERNAME=lcuser
DB_PASSWORD=lcdev

# MinIO — false = memory-only PDF cache (Mac local). true = Ubuntu MinIO at :9000.
STORAGE_MINIO_REQUIRED=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Preset test bundles (optional — `make svc` / `make all` set this to <repo>/test/cases)
# PRESETS_DIR=

# Langfuse — set LANGFUSE_ENABLED=false for Mac local (no Ubuntu :3300).
# When true: fill keys; run `make langfuse-auth` to derive LANGFUSE_AUTH_BASIC.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_AUTH_BASIC=

# --- tb-helix-ai-svc (:9090) ------------------------------------------------
# Slots are numbered and uniform; nothing here names a vendor. A provider switch
# is a base URL and a key. Roles map to slots in application.yml.
LLM_1_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_1_API_KEY=
LLM_1_MODEL=qwen3.7-flash
LLM_2_BASE_URL=
LLM_2_API_KEY=
LLM_2_MODEL=

VLM_1_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_1_API_KEY=
VLM_1_MODEL=qwen3.7-vl-flash
VLM_2_BASE_URL=
VLM_2_API_KEY=
VLM_2_MODEL=

# DISK locally (browsable tree, real file extensions); DB on the server
# (shared between instances, survives a redeploy). S3 later.
# Default (when unset): ${user.home}/ws/tmp/var/blob  — works on Linux/macOS/Windows.
HELIX_BLOB_TIER=DISK
# HELIX_BLOB_ROOT=/Users/you/ws/tmp/var/blob

# L3 derivation cache (LLM/VLM structured answers + convert pointers).
# Local: DISK → ~/ws/tmp/var/derivation/<op>/aa/bb/<key>.json (+ .md raw text)
# System testing: DB → helix_infra.derivation
HELIX_CACHE_L3_STORAGE=DISK
# HELIX_CACHE_L3_DISK_ROOT=/Users/you/ws/tmp/var/derivation
# HELIX_CACHE_L3_WRITE_MD=true


# LIVE reads governance checks directly, so an edit applies to the next run.
# RELEASE reads the pinned snapshot — what makes an examination defensible.
HELIX_CATALOG_PIN=LIVE
